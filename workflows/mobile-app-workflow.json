    {
      "parameters": {
        "jsCode": "let r = $input.first().json;\nr = r.message?.content ?? r.output?.[0]?.content?.[0]?.text ?? r.output ?? r;\nif (typeof r === 'string') r = JSON.parse(r.replace(/```json|```/g, '').trim());\n\nreturn [{ json: {\n  name: r.name || '',\n  email: r.email || '',\n  summary: r.summary || '',\n  skills: r.skills || [],\n  education: r.education || [],\n  experience: r.experience || [],\n  certifications: r.certifications || []\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2224,
        -96
      ],
      "id": "bc158bcc-b6da-4cd7-aa64-14dd618754e1",
      "name": "Clean parsed CV1"
    },
    {
      "parameters": {
        "jsCode": "const role = $('Get job').first().json;\nlet r = $input.first().json;\nr = r.message?.content ?? r.output?.[0]?.content?.[0]?.text ?? r.output ?? r;\nif (typeof r === 'string') r = JSON.parse(r.replace(/```json|```/g, '').trim());\n\nconst clamp = v => Math.max(0, Math.min(100, Number(v) || 0));\nconst w = {\n  skills: Number(role.W_Skills) || 40,\n  experience: Number(role.W_Experience) || 30,\n  education: Number(role.W_Education) || 20,\n  certs: Number(role.W_Certs) || 10\n};\nconst total = w.skills + w.experience + w.education + w.certs;\n\nconst overall = Math.round((\n  clamp(r.skillMatch) * w.skills +\n  clamp(r.experienceMatch) * w.experience +\n  clamp(r.educationMatch) * w.education +\n  clamp(r.certificationMatch) * w.certs\n) / total);\n\nconst status = overall >= 75 ? 'Strong Match'\n             : overall >= 50 ? 'Possible Match'\n             : 'Not a Match';\n\nreturn [{ json: {\n  overallScore: overall,\n  skillMatch: clamp(r.skillMatch),\n  experienceMatch: clamp(r.experienceMatch),\n  educationMatch: clamp(r.educationMatch),\n  certificationMatch: clamp(r.certificationMatch),\n  summary: r.aiSummary,\n  strengths: (r.strengths || []).join('\\n'),\n  weaknesses: (r.weaknesses || []).join('\\n'),\n  status\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        -96
      ],
      "id": "0c2ca7b6-8a76-41cb-a06f-cb0568f07208",
