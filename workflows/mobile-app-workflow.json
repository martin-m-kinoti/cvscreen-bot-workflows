      "parameters": {
        "jsCode": "const toPgArray = (v) => {\n  let arr = v;\n  if (typeof arr === 'string') {\n    try { arr = JSON.parse(arr); } catch { arr = [arr]; }\n  }\n  if (!Array.isArray(arr)) arr = [];\n  return '{' + arr\n    .map(s => '\"' + String(s).replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"') + '\"')\n    .join(',') + '}';\n};\n\nconst item = $input.item.json;\n\nreturn {\n  json: {\n    ...item,\n    strengths: toPgArray(item.strengths),\n    weaknesses: toPgArray(item.weaknesses),\n  },\n};"
      },
